          <mxGeometry x="280" y="100" width="150" height="70" as="geometry"/>
        </mxCell>

        <!-- Instruction Memory  col B row 2 -->
        <mxCell id="imem" value="&lt;b&gt;Instruction Memory&lt;/b&gt;&lt;br&gt;fetch 32-bit instruction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;verticalAlign=middle;" vertex="1" parent="1">
